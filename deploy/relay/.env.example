RELAY_DOMAIN=code.example.com
RELAY_PUBLIC_URL=https://code.example.com
RELAY_ALLOWED_ORIGINS=https://code.example.com
RELAY_POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
RELAY_SESSION_COOKIE_SECRET=replace-with-at-least-32-random-bytes
RELAY_EMAIL_FROM=Wobex <code@example.com>

# Keep false for real public deployments.
# Set true only for a private smoke test while email delivery is still wired up.
RELAY_DEBUG_AUTH_CODES=false

RELAY_MAX_BODY_BYTES=1048576
RELAY_PROXY_TIMEOUT_MS=15000
